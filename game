<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nani's Gluten Free Beer Pong</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Custom CSS for arcade/neon styling */
        body {
            background-color: #000000;
            color: #ffffff;
            font-family: 'Press Start 2P', monospace; /* Arcade-themed font */
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            width: 100vw; /* Ensure full width coverage */
            margin: 0;
            padding: 0; /* Remove padding to avoid mobile scrolling issues */
            overflow: hidden; /* Prevent scrolling */
        }

        #game-container {
            position: relative;
            width: 95vw; /* Use 95% of viewport width */
            max-width: 800px;
            aspect-ratio: 4 / 3; /* Classic arcade aspect ratio */
            box-shadow: 0 0 20px rgba(0, 255, 255, 0.8), 0 0 50px rgba(0, 255, 255, 0.4);
            border: 5px solid #0ff;
            border-radius: 10px;
            background-color: #000; /* Ensure black background for neon */
        }

        canvas {
            display: block;
            width: 100%;
            height: 100%;
            background-color: #000;
        }

        #message-box {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(0, 0, 0, 0.85);
            padding: 20px;
            border: 3px solid #f0f; /* Neon Magenta */
            border-radius: 8px;
            text-align: center;
            color: #0f0; /* Neon Green */
            box-shadow: 0 0 15px #f0f;
            z-index: 10;
            width: 80%;
            max-width: 450px; 
        }

        #message-box h2 {
            font-size: 1.2rem; 
            margin-bottom: 10px;
            color: #fff;
            text-shadow: 0 0 5px #0ff;
        }
        
        #message-box p {
            margin-bottom: 10px;
        }

        #start-button {
            margin-top: 15px;
            padding: 10px 20px;
            background-color: #0ff;
            color: #000;
            font-weight: bold;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            box-shadow: 0 0 10px #0ff, 0 0 20px #0ff;
            transition: all 0.2s;
        }

        #start-button:hover {
            background-color: #fff;
            box-shadow: 0 0 20px #0ff, 0 0 40px #0ff;
        }

        .arcade-font {
            font-family: 'Press Start 2P', monospace;
            text-shadow: 0 0 5px rgba(255, 255, 255, 0.8);
        }
        
        .invitation-text {
             font-size: 0.75rem; 
             line-height: 1.5;
             color: #0ff; /* Neon Cyan for the invite */
             text-shadow: 0 0 3px rgba(0, 255, 255, 0.5);
        }

        /* Responsive adjustments for mobile screens */
        @media (max-width: 480px) {
            #message-box {
                padding: 15px;
                width: 90%;
            }
            #message-box h2 {
                font-size: 1rem;
            }
            #message-box p {
                font-size: 0.7rem;
            }
            .invitation-text {
                font-size: 0.65rem; /* Ensure invitation fits well */
            }
            #start-button {
                font-size: 0.8rem;
                padding: 8px 16px;
            }
        }
    </style>
    

<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
</head>
<body>
    <div id="game-container">
        <canvas id="beerPongCanvas"></canvas>
        <div id="message-box" class="hidden">
            <h2 class="arcade-font">NANI'S GLUTEN FREE BEER PONG</h2>
            <p class="arcade-font text-sm">Controle seu paddle (Esquerda) com o mouse ou toque.</p>
            <p class="arcade-font text-xs mt-3">Acerte os 4 copos para ganhar o convite!</p>
            <button id="start-button" class="arcade-font">JOGAR</button>
        </div>
    </div>
    
    <script>
        const canvas = document.getElementById('beerPongCanvas');
        const ctx = canvas.getContext('2d');
        const messageBox = document.getElementById('message-box');
        const startButton = document.getElementById('start-button');

        // Neon Colors
        const COLOR_PADDLE_1 = '#00ff00'; // Neon Green
        const COLOR_PADDLE_2 = '#ff00ff'; // Neon Magenta
        const COLOR_BALL = '#00ffff';     // Neon Cyan
        const COLOR_TEXT = '#ffff00';    // Neon Yellow
        const COLOR_CUP_FULL = '#ff4500'; // OrangeRed (for beer)
        const COLOR_CUP_EMPTY = '#808080'; // Grey for empty cups
        const COLOR_GLOW_INTENSITY = 8;

        // Game State
        let game = {
            running: false,
            animationFrameId: null,
            difficulty: 0.15 // AI difficulty (Beginner-friendly)
        };

        // Paddle Properties
        const PADDLE_W = 10;
        let paddleH; // Defined in resizeCanvas
        
        let paddle1 = {
            x: 20,
            y: 0,
            dy: 0
        };

        let paddle2 = {
            x: 0, // Defined in resizeCanvas
            y: 0,
            dy: 0
        };

        // Ball Properties
        const BALL_SIZE = 10;
        const INITIAL_BALL_SPEED = 6;
        let ball = {
            x: 0,
            y: 0,
            dx: 0,
            dy: 0,
            speed: INITIAL_BALL_SPEED
        };

        // Cup Properties
        const CUP_RADIUS = 15;
        const CUP_SPACING = 30;
        let cupsPlayer2 = []; // Array of {x, y, hit: boolean} objects
        const NUM_CUPS = 4; // Requested number of cups

        let mouseY = canvas.height / 2;

        // --- Drawing Functions ---

        function drawRect(x, y, w, h, color) {
            ctx.fillStyle = color;
            ctx.shadowColor = color;
            ctx.shadowBlur = COLOR_GLOW_INTENSITY;
            ctx.fillRect(x, y, w, h);
            ctx.shadowBlur = 0;
            ctx.shadowColor = 'transparent';
        }

        function drawBall(x, y, size, color) {
            ctx.fillStyle = color;
            ctx.shadowColor = color;
            ctx.shadowBlur = COLOR_GLOW_INTENSITY;
            ctx.beginPath();
            ctx.arc(x, y, size / 2, 0, Math.PI * 2);
            ctx.fill();
            ctx.closePath();
            ctx.shadowBlur = 0;
            ctx.shadowColor = 'transparent';
        }

        function drawCup(x, y, radius, hit) {
            const color = hit ? COLOR_CUP_EMPTY : COLOR_CUP_FULL;
            ctx.fillStyle = color;
            ctx.shadowColor = color;
            ctx.shadowBlur = COLOR_GLOW_INTENSITY / 2;
            ctx.beginPath();
            ctx.arc(x, y, radius, 0, Math.PI * 2);
            ctx.fill();
            ctx.closePath();
            ctx.shadowBlur = 0;
            ctx.shadowColor = 'transparent';

            // Draw a small rim or detail
            ctx.strokeStyle = hit ? '#444' : '#fff';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.arc(x, y, radius, 0, Math.PI * 2);
            ctx.stroke();
            ctx.closePath();
        }

        function drawCups() {
            cupsPlayer2.forEach(cup => {
                drawCup(cup.x, cup.y, CUP_RADIUS, cup.hit);
            });
        }

        function drawScore() {
            ctx.fillStyle = COLOR_TEXT;
            
            // Make font size relative to canvas width for responsiveness
            const fontSize = Math.max(12, canvas.width / 40); 
            ctx.font = `${fontSize}px "Press Start 2P", monospace`;
            
            ctx.textAlign = 'left';
            ctx.shadowColor = COLOR_TEXT;
            ctx.shadowBlur = 5;

            let cupsHit = cupsPlayer2.filter(c => c.hit).length;
            // Use relative positioning for score
            ctx.fillText(`COPOS RESTANTES: ${NUM_CUPS - cupsHit}`, canvas.width * 0.05, canvas.height * 0.07);
            
            ctx.shadowBlur = 0;
            ctx.shadowColor = 'transparent';
        }

        function drawNet() {
            ctx.strokeStyle = '#333333';
            ctx.lineWidth = 4;
            ctx.beginPath();
            ctx.setLineDash([10, 10]);
            ctx.moveTo(canvas.width / 2, 0);
            ctx.lineTo(canvas.width / 2, canvas.height);
            ctx.stroke();
            ctx.setLineDash([]);
        }

        // --- Game Logic Functions ---

        function initCups() {
            cupsPlayer2 = [];
            
            // Calculate relative values for responsive cup positioning
            const cupRadius = canvas.width * 0.025; // Relative radius
            const cupSpacing = canvas.width * 0.05; // Relative spacing
            const startX = canvas.width - (canvas.width * 0.2); // Position cups 20% from right edge
            const baseY = canvas.height / 2;

            // Row 1 (2 cups - center-left pair)
            cupsPlayer2.push({ x: startX + cupSpacing * 0.5, y: baseY - cupSpacing / 2, hit: false, radius: cupRadius });
            cupsPlayer2.push({ x: startX + cupSpacing * 0.5, y: baseY + cupSpacing / 2, hit: false, radius: cupRadius });

            // Row 2 (1 cup - front)
            cupsPlayer2.push({ x: startX + cupSpacing * 1.5, y: baseY, hit: false, radius: cupRadius });
            
            // Row 3 (1 cup - back)
            cupsPlayer2.push({ x: startX - cupSpacing * 0.5, y: baseY, hit: false, radius: cupRadius });

            // Re-sort to draw properly (optional but good practice)
            cupsPlayer2.sort((a, b) => a.x - b.x); 
        }

        function resetBall() {
            ball.x = canvas.width / 2;
            ball.y = canvas.height / 2;
            ball.speed = INITIAL_BALL_SPEED;

            const angle = Math.random() * Math.PI / 2 - Math.PI / 4;
            const direction = (Math.random() < 0.5 ? 1 : -1); 

            ball.dx = direction * ball.speed * Math.cos(angle);
            ball.dy = ball.speed * Math.sin(angle);
        }

        function update() {
            if (!game.running) return;

            // 1. Move Ball
            ball.x += ball.dx;
            ball.y += ball.dy;

            // 2. AI Movement (Paddle 2)
            const targetY = ball.y - paddleH / 2;
            const diff = targetY - paddle2.y;
            paddle2.y += diff * game.difficulty;
            paddle2.y = Math.max(0, Math.min(canvas.height - paddleH, paddle2.y));

            // 3. Player Movement (Paddle 1)
            const playerCenterY = paddle1.y + paddleH / 2;
            const moveDiff = mouseY - playerCenterY;
            paddle1.y += moveDiff * 0.2; // Smooth movement
            paddle1.y = Math.max(0, Math.min(canvas.height - paddleH, paddle1.y));

            // 4. Ball collision with top/bottom walls
            if (ball.y < BALL_SIZE / 2 || ball.y > canvas.height - BALL_SIZE / 2) {
                ball.dy *= -1;
            }

            // 5. Collision with Paddles
            checkPaddleCollision(paddle1, true);
            checkPaddleCollision(paddle2, false);

            // 6. Collision with Cups (Player 2's cups)
            cupsPlayer2.forEach(cup => {
                if (!cup.hit) { // Only check if cup is not already hit
                    const distanceX = ball.x - cup.x;
                    const distanceY = ball.y - cup.y;
                    const distance = Math.sqrt(distanceX * distanceX + distanceY * distanceY);

                    // Use the cup's dynamic radius for collision check
                    if (distance < BALL_SIZE / 2 + cup.radius) {
                        cup.hit = true; // Mark cup as hit
                        ball.dx *= -1; // Bounce the ball back
                        ball.speed = INITIAL_BALL_SPEED; // Reset speed after hitting a cup
                        checkGameOver();
                    }
                }
            });

            // 7. Ball out of bounds
            if (ball.x < 0 || ball.x > canvas.width) {
                resetBall(); // Just reset ball, no score for missing entirely
            }
        }
        
        function checkPaddleCollision(paddle, isLeft) {
            const paddleX = isLeft ? paddle.x + PADDLE_W : paddle.x;
            const ballCenterY = ball.y;
            const ballCenterP = ball.x;

            const inVerticalRange = ballCenterY + BALL_SIZE/2 > paddle.y && ballCenterY - BALL_SIZE/2 < paddle.y + paddleH;
            
            let inHorizontalRange = false;
            
            if (isLeft) {
                inHorizontalRange = ballCenterP - BALL_SIZE / 2 <= paddleX && ballCenterP - BALL_SIZE / 2 > paddleX - PADDLE_W;
            } else {
                inHorizontalRange = ballCenterP + BALL_SIZE / 2 >= paddleX && ballCenterP + BALL_SIZE / 2 < paddleX + PADDLE_W;
            }

            if (inVerticalRange && inHorizontalRange) {
                ball.dx *= -1; 
                ball.speed = Math.min(ball.speed * 1.05, 18); // Max speed slightly higher
                const relativeIntersectY = (paddle.y + (paddleH / 2)) - ballCenterY;
                const normalizedRelativeIntersectionY = relativeIntersectY / (paddleH / 2);
                const bounceAngle = normalizedRelativeIntersectionY * (Math.PI / 4); 

                ball.dx = Math.sign(ball.dx) * ball.speed * Math.cos(bounceAngle);
                ball.dy = -ball.speed * Math.sin(bounceAngle);
            }
        }

        function checkGameOver() {
            const cupsHit = cupsPlayer2.filter(cup => cup.hit).length;
            if (cupsHit >= NUM_CUPS) {
                game.running = false;
                cancelAnimationFrame(game.animationFrameId);
                
                // Custom invitation message
                const invitationText = `YEAH! Você acertou todos os copos e está convidado(a) para o Parabéns da Nani! Brinde comigo no dia 25/10, às 14h30 no Candiá, na Francisco Sá, 430.`;
                displayInvitation('VITÓRIA!', invitationText, 'JOGAR NOVAMENTE');
            }
        }

        function gameLoop() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            drawNet();
            drawScore();
            drawRect(paddle1.x, paddle1.y, PADDLE_W, paddleH, COLOR_PADDLE_1);
            drawRect(paddle2.x, paddle2.y, PADDLE_W, paddleH, COLOR_PADDLE_2);
            drawBall(ball.x, ball.y, BALL_SIZE, COLOR_BALL);
            drawCups();

            update();

            game.animationFrameId = requestAnimationFrame(gameLoop);
        }

        // --- Initialization and UI Functions ---

        function resizeCanvas() {
            const container = document.getElementById('game-container');
            canvas.width = container.clientWidth;
            canvas.height = container.clientHeight;

            paddleH = canvas.height / 5; // Large paddle for beginners

            paddle1.y = canvas.height / 2 - paddleH / 2;
            
            // Keep paddles near the edge, respecting PADDLE_W
            paddle1.x = canvas.width * 0.03; // 3% from left edge
            paddle2.x = canvas.width - PADDLE_W - (canvas.width * 0.03); // 3% from right edge
            
            paddle2.y = canvas.height / 2 - paddleH / 2;

            initCups(); // Re-initialize cup positions on resize

            if (!game.running) {
                resetBallPositionOnly();
            }
        }
        
        function resetBallPositionOnly() {
             ball.x = canvas.width / 2;
             ball.y = canvas.height / 2;
        }


        // Updated function to allow custom button text (for initial load)
        function displayMessage(title, subtitle = 'Clique para INICIAR', buttonText = 'JOGAR NOVAMENTE') {
            messageBox.querySelector('h2').textContent = title;
            messageBox.querySelectorAll('p').forEach(p => p.remove()); // Remove all previous <p>
            
            const p = document.createElement('p');
            p.className = 'arcade-font text-sm';
            p.textContent = subtitle;
            messageBox.insertBefore(p, startButton);
            
            startButton.textContent = buttonText;
            messageBox.classList.remove('hidden');
            startButton.classList.remove('invitation-text'); // Remove invitation class if present
        }
        
        // Updated function to allow custom button text (for replay)
        function displayInvitation(title, message, buttonText = 'JOGAR NOVAMENTE') {
            messageBox.querySelector('h2').textContent = title;
            messageBox.querySelectorAll('p').forEach(p => p.remove()); // Remove all previous <p>
            
            const p = document.createElement('p');
            p.className = 'arcade-font invitation-text'; // Use dedicated class for styling
            p.textContent = message;
            messageBox.insertBefore(p, startButton);
            
            startButton.textContent = buttonText;
            messageBox.classList.remove('hidden');
            startButton.classList.add('invitation-text'); // Add a visual cue to the button if needed
        }


        function startGame() {
            game.running = true;
            messageBox.classList.add('hidden');
            
            initCups(); // Reset all cups
            resetBall(); 
            resizeCanvas(); // Ensure paddles and cups are correctly positioned

            if (game.animationFrameId) {
                 cancelAnimationFrame(game.animationFrameId);
            }
            gameLoop();
        }

        // --- Event Listeners ---

        function handleInput(event) {
            let clientY;
            if (event.touches) {
                clientY = event.touches[0].clientY;
            } else {
                clientY = event.clientY;
            }

            const rect = canvas.getBoundingClientRect();
            mouseY = clientY - rect.top; 

            if (event.touches) {
                event.preventDefault(); 
            }
        }

        startButton.addEventListener('click', startGame);

        canvas.addEventListener('mousemove', handleInput);
        // Important: passive: false is kept for touchmove to prevent default scrolling
        canvas.addEventListener('touchmove', handleInput, { passive: false }); 
        canvas.addEventListener('touchstart', handleInput, { passive: false });

        window.addEventListener('resize', resizeCanvas);


        // Initial setup
        window.onload = () => {
            resizeCanvas();
            // Pass 'JOGAR' explicitamente para a carga inicial
            displayMessage(
                'NANI\'S GLUTEN FREE BEER PONG', 
                'Controle seu paddle (Esquerda) com o mouse ou toque. Acerte os 4 copos para ganhar o convite!', 
                'JOGAR' // Botão inicial
            );
        };
    </script>
</body>
</html>
